{
  "name": "@zeroicey/engram",
  "version": "0.5.0",
  "description": "Pi-only project memory + scaffolder (.ai/ memory bank, AGENTS.md contract, ≤1.5KB context fingerprint, opt-in goal engine).",
  "keywords": [
    "pi",
    "ai",
    "agent",
    "memory",
    "context",
    "agents-md",
    "skills",
    "scaffold",
    "goal",
    "autonomous"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "engram": "build/src/cli.js"
  },
  "exports": {
    ".": "./build/src/index.js"
  },
  "files": [
    "build/src",
    "src",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test build/test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "js-yaml": "^5.4.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroicey/engram.git"
  },
  "homepage": "https://github.com/zeroicey/engram#readme",
  "bugs": {
    "url": "https://github.com/zeroicey/engram/issues"
  }
}
